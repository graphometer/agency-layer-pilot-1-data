{"content": "\"\"\"Sanity-checks alerts.yaml without external dependencies.\"\"\"\nimport sys\n\n\ndef main():\n    problems = []\n    with open(\"alerts.yaml\", \"r\", encoding=\"utf-8\") as fh:\n        lines = fh.readlines()\n    if not any(line.strip().startswith(\"- name:\") for line in lines):\n        problems.append(\"no rules found\")\n    for line in lines:\n        stripped = line.strip()\n        if stripped.startswith(\"notify:\"):\n            raw = stripped.split(\":\", 1)[1].strip()\n            if raw[:1] in ('\"', \"'\"):\n                quote = raw[0]\n                end = raw.find(quote, 1)\n                value = raw[1:end] if end != -1 else raw[1:]\n            else:\n                value = raw.split(\"#\", 1)[0].strip()\n            if not value:\n                problems.append(\"a rule has an empty notify target\")\n    for problem in problems:\n        print(f\"FAIL: {problem}\")\n    if problems:\n        return 1\n    print(\"alerts.yaml ok\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n", "guard": {"allowed": true, "state": null}, "index": 3, "is_error": false, "role": "tool_result", "tool_call_id": "jsf4iWOlLZ27AGGIyxgvy4gRwOqUrhV8", "tool_name": "read_file"}
