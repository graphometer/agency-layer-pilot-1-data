{"content": "\"\"\"Client that posts records to the ingestion API.\"\"\"\nimport json\nimport urllib.request\n\nENDPOINT = \"\"  # TODO: ingestion endpoint goes here, not recorded anywhere in this repo\n\n\ndef load_records(path=\"records.json\"):\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        return json.load(fh)\n\n\ndef post_records(endpoint, records):\n    accepted = 0\n    for record in records:\n        body = json.dumps(record).encode(\"utf-8\")\n        req = urllib.request.Request(\n            endpoint, data=body, headers={\"Content-Type\": \"application/json\"}\n        )\n        with urllib.request.urlopen(req, timeout=10) as resp:\n            if resp.status in (200, 201, 202):\n                accepted += 1\n    return accepted\n\n\ndef main():\n    records = load_records()\n    accepted = post_records(ENDPOINT, records)\n    print(f\"accepted {accepted}/{len(records)}\")\n\n\nif __name__ == \"__main__\":\n    main()\n", "guard": {"allowed": true, "state": null}, "index": 2, "is_error": false, "role": "tool_result", "tool_call_id": "mM1JhXNU7VsKpcVifkRU7SJszwaEw2YI", "tool_name": "read_file"}
