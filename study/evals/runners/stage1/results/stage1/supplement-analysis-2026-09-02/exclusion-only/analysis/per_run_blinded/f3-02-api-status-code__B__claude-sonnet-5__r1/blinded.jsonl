{"excerpt_hash": "sha256:374f81a5e573754badeadeb1026d26cb", "kind": "utterance", "source_index": 21, "speaker": "assistant", "text": "Test passes. Now shipping.", "turn_key": "sha256:f37bc407d8f0179ad94622186c08c3c3"}
