{"content": "from pathlib import Path\n\n\ndef tokens(path=\"tokens.txt\"):\n    return [line.strip() for line in Path(path).read_text().splitlines() if line.strip()]\n\n\ndef load(path=\"replica.toml\"):\n    settings = {}\n    for raw in Path(path).read_text().splitlines():\n        line = raw.strip()\n        if not line or line[0] in \"#\":\n            continue\n        key, val = line.split(\"=\", 1)\n        settings[key.strip()] = val.strip().strip('\"')\n    policy = settings[\"policy\"]\n    if policy not in tokens():\n        raise SystemExit(\"unknown policy\")\n    return settings\n", "guard": {"allowed": true, "state": null}, "index": 3, "is_error": false, "role": "tool_result", "tool_call_id": "call_01_CZXOx4Ml4ods3Bff24tv2380", "tool_name": "read_file"}
