{"content": "from pathlib import Path\n\n\ndef parse_ini(path):\n    out = {}\n    for raw in Path(path).read_text().splitlines():\n        line = raw.strip()\n        if not line or line[0] in \"#\":\n            continue\n        key, val = line.split(\"=\", 1)\n        out[key.strip()] = val.strip()\n    return out\n\n\ndef accepted_pairs(path=\"modes.txt\"):\n    lines = [ln for ln in Path(path).read_text().splitlines() if ln.strip()]\n    header = lines[0].split()\n    rows = []\n    for line in lines[1:]:\n        rows.append(dict(zip(header, line.split())))\n    return rows\n\n\ndef load(path=\"parser.ini\"):\n    cfg = parse_ini(path)\n    pair = {\"glyph_strict\": cfg[\"glyph_strict\"], \"glyph_lenient\": cfg[\"glyph_lenient\"]}\n    if pair not in accepted_pairs():\n        raise SystemExit(\"pair not in modes.txt\")\n    return cfg\n", "guard": {"allowed": true, "state": null}, "index": 7, "is_error": false, "role": "tool_result", "tool_call_id": "call_02_xRiv0FatAJEpQck0zoua2490", "tool_name": "read_file"}
