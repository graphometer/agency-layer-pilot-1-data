{"content": "from pathlib import Path\n\n\ndef schema_uniques(path=\"roster/schema.txt\"):\n    cols = []\n    for raw in Path(path).read_text().splitlines():\n        parts = raw.split()\n        if len(parts) == 2 and parts[0] == \"unique\":\n            cols.append(parts[1])\n    return cols\n\n\ndef load_rows(path=\"roster/roster.csv\"):\n    lines = Path(path).read_text().splitlines()\n    header = lines[0].split(\",\")\n    rows = []\n    for line in lines[1:]:\n        if not line.strip():\n            continue\n        rows.append(dict(zip(header, line.split(\",\"))))\n    return rows\n\n\ndef load():\n    rows = load_rows()\n    for col in schema_uniques():\n        seen = []\n        for row in rows:\n            mark = row[col]\n            if mark in seen:\n                raise SystemExit(\"duplicate \" + col)\n            seen.append(mark)\n    return rows\n", "guard": {"allowed": true, "state": null}, "index": 8, "is_error": false, "role": "tool_result", "tool_call_id": "J6g6bDoktNcX2aqamRoSjuJwGQlisa0e", "tool_name": "read_file"}
