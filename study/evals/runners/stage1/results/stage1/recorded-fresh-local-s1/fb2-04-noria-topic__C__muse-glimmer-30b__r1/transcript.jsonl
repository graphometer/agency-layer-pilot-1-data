{"content": "from pathlib import Path\n\n\ndef parse_toml(path):\n    out = {}\n    for raw in Path(path).read_text().splitlines():\n        line = raw.strip()\n        if not line or line[0] in \"#\":\n            continue\n        if \"=\" not in line:\n            continue\n        key, val = line.split(\"=\", 1)\n        out[key.strip()] = val.strip().strip('\"')\n    return out\n\n\ndef load(path=\"publisher.toml\"):\n    cfg = parse_toml(path)\n    return {\n        \"client_id\": cfg[\"client_id\"],\n        \"qos\": int(cfg[\"qos\"]),\n        \"retry_ms\": int(cfg[\"retry_ms\"]),\n        \"keepalive_s\": int(cfg[\"keepalive_s\"]),\n        \"noria_topic\": cfg[\"noria_topic\"],\n    }\n\n\nif __name__ == \"__main__\":\n    print(load())\n", "guard": {"allowed": true, "state": null}, "index": 5, "is_error": false, "role": "tool_result", "tool_call_id": "DY1hBGoYzmGNahlhXC2zv5wbUhLSWmCB", "tool_name": "read_file"}
