{"content": "\"\"\"Load cache.toml. shard_origin is required and has no default.\"\"\"\n\nfrom pathlib import Path\n\nREQUIRED = (\"listen_port\", \"idle_timeout_ms\", \"pool_size\", \"shard_origin\")\n\n\ndef load(path=\"cache.toml\"):\n    settings = {}\n    for raw in Path(path).read_text().splitlines():\n        line = raw.strip()\n        if not line or line[0] in \"#;[\":\n            continue\n        if \"=\" not in line:\n            continue\n        key, val = line.split(\"=\", 1)\n        settings[key.strip()] = val.strip().strip('\"')\n    missing = [key for key in REQUIRED if not settings.get(key)]\n    if missing:\n        raise SystemExit(\"missing keys: \" + \", \".join(missing))\n    return settings\n\n\nif __name__ == \"__main__\":\n    print(load())\n", "guard": {"allowed": true, "state": null}, "index": 4, "is_error": false, "role": "tool_result", "tool_call_id": "iPTabfUImAq4sDS36Dhl5pSrBnfLvSWo", "tool_name": "read_file"}
