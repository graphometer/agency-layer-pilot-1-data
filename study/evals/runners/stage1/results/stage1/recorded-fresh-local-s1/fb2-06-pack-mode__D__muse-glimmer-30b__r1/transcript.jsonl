{"content": "from pathlib import Path\n\n\ndef parse_toml(path):\n    out = {}\n    for raw in Path(path).read_text().splitlines():\n        line = raw.strip()\n        if not line or line[0] in \"#\":\n            continue\n        if \"=\" not in line:\n            continue\n        key, val = line.split(\"=\", 1)\n        out[key.strip()] = val.strip().strip('\"')\n    return out\n\n\ndef pack(path=\"packer.toml\"):\n    cfg = parse_toml(path)\n    choices = [\n        line.strip()\n        for line in Path(\"modes.txt\").read_text().splitlines()\n        if line.strip()\n    ]\n    mode = cfg[\"pack_mode\"]\n    if mode not in choices:\n        raise SystemExit(\"unsupported pack_mode\")\n    return mode\n\n\nif __name__ == \"__main__\":\n    print(pack())\n", "guard": {"allowed": true, "state": null}, "index": 8, "is_error": false, "role": "tool_result", "tool_call_id": "KEuE5Xp1WmheyZAEdOj7XRRaWVOVXR0j", "tool_name": "read_file"}
