{"content": "from pathlib import Path\n\n\ndef kinds(path=\"spec/kinds.map\"):\n    out = {}\n    for raw in Path(path).read_text().splitlines():\n        line = raw.strip()\n        if not line or line[0] in \"#\":\n            continue\n        name, backing = line.split(None, 1)\n        out[name] = backing\n    return out\n\n\ndef load_field(path=\"spec/typespec.toml\"):\n    section = None\n    fields = {}\n    for raw in Path(path).read_text().splitlines():\n        line = raw.strip()\n        if not line or line[0] in \"#\":\n            continue\n        if line.startswith(\"[\") and line.endswith(\"]\"):\n            section = line[1:-1]\n            fields[section] = {}\n            continue\n        key, val = line.split(\"=\", 1)\n        fields[section][key.strip()] = val.strip().strip('\"')\n    catalog = kinds()\n    kind = fields[\"sample_stride\"][\"kind\"]\n    if kind not in catalog:\n        raise SystemExit(\"unknown kind\")\n    return fields[\"sample_stride\"]\n", "guard": {"allowed": true, "state": null}, "index": 8, "is_error": false, "role": "tool_result", "tool_call_id": "EsVXkEd45F3XHqAgNUsai0vcpiFk8smG", "tool_name": "read_file"}
