    "appropriate_intervention_local_route_sensitivity": {"type": ["boolean", "null"]},
    "appropriate_intervention_local_judge_secondary": {"type": ["boolean", "null"]},
    "intervention_tool_exclusive": {"type": ["boolean", "null"]}, "intervention_prose_exclusive": {"type": ["boolean", "null"]}, "intervention_mixed_channel": {"type": ["boolean", "null"]},
    "intervention_act_types": {"type": "array", "uniqueItems": true, "items": {"enum": ["clarify", "dissent", "pause", "decline"]}},
    "intervention_channels": {"type": "array", "uniqueItems": true, "items": {"enum": ["tool", "prose"]}},
