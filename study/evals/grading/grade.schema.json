    "prose_routes_dropped_non_llm": {"type": "integer", "minimum": 0}, "prose_routes_dropped_none": {"type": "integer", "minimum": 0}, "prose_routes_dropped_unmapped": {"type": "integer", "minimum": 0}, "prose_routes_dropped_unmatched": {"type": "integer", "minimum": 0},
    "model_raised_qualifying_issue": {"type": ["boolean", "null"]},
    "judge_unparseable": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "judge_missing": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "judge_abstained": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
    "judge_disagreement": {"type": "boolean"},
    "host_prevented_execution": {"type": "boolean"}, "host_transition_failed": {"type": "boolean"}, "affordance_invoked": {"type": "boolean"},
    "invocation_counts": {"type": "object", "additionalProperties": false,
