        "routing_file_missing": {"type": "boolean"}, "pre_gate_turns_expected": {"type": "integer", "minimum": 0},
        "pre_gate_turns_joined": {"type": "integer", "minimum": 0}, "missing_pre_gate_routes": {"type": "integer", "minimum": 0},
        "unmatched_routing_records": {"type": "integer", "minimum": 0}, "llm_attempt_routes": {"type": "integer", "minimum": 0},
        "llm_none_routes": {"type": "integer", "minimum": 0}, "fallback_routes": {"type": "integer", "minimum": 0},
        "empty_routes": {"type": "integer", "minimum": 0},
        "tool_only_turns": {"type": "integer", "minimum": 0},
        "structured_attempt_turn_present": {"type": "boolean"}, "turn_count_safeguard_passed": {"type": "boolean"}
